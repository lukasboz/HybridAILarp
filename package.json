{
  "name": "meethalfway",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "type": "module",
  "description": "One Flutter interface for fairer group plans on web, Android and iOS.",
  "scripts": {
    "dev": "bash scripts/flutter.sh run -d web-server --web-hostname 0.0.0.0 --web-port 4173",
    "build": "bash scripts/flutter.sh build web --release --no-web-resources-cdn && python3 scripts/package-flutter-web.py",
    "test": "bash scripts/flutter.sh test",
    "check": "bash scripts/flutter.sh analyze",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-meethalfway \"node --test tests/firestore.rules.test.mjs\"",
    "preview": "python3 -m http.server 4173 --bind 0.0.0.0 --directory dist",
    "build:android": "bash scripts/flutter.sh build apk --debug",
    "build:ios": "bash scripts/flutter.sh build ios --release --no-codesign",
    "dev:legacy": "node scripts/serve.mjs",
    "build:legacy": "node scripts/build.mjs",
    "check:legacy": "node scripts/check.mjs",
    "test:legacy": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "esbuild": "^0.28.2",
    "firebase": "^13.3.0",
    "happy-dom": "^21.0.4"
  }
}
