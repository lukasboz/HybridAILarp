rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Prototype rules; review before broad release.
    // users/{uid}: private name(1..30), approved default card, updatedAt.
    // users/{uid}/devices/{id}: private FCM installation ID, platform, updatedAt.
    // users/{uid}/inbox/{event}: server-written notifications; owner reads/deletes.
    // rooms/{id}/events/{id}: bounded type, actorId, revision, createdAt.
    // Options may include duration, Toronto coordinates and OSM provenance.
    // Proposal.stops optionally binds 2..3 ordered stops to the same revision.
    // deleting=true freezes all child writes while the owner purges the room.
    // Existing schema:
    // rooms/{36-hex-id}: title(1..70), date(YYYY-MM-DD, format-only), city='Toronto',
    // ownerId(immutable UID), memberIds(1..8 distinct UIDs), status enum,
    // revision(int), proposal(null or candidateId/startMinute/revision),
    // lastJoinInviteId(48-hex), createdAt(immutable server timestamp).
    // rooms/{id}/members/{uid}: name(1..30, shared room display name),
    // card(null or allowlisted approved preferences), inviteId(immutable), updatedAt.
    // Raw private notes, exact locations, emails and credentials have NO cloud field.
    // rooms/{id}/votes/{uid}: choice enum, candidateId, revision, updatedAt.
    // invites/{48-hex-token}: roomId, title, createdBy, expiresAt (max 7 days).
    // Invite get is a capability lookup; invite listing is always denied.
    // The host renews an expiring link by pointing lastJoinInviteId at a new invite.
    // Membership changes and preference changes atomically reopen the plan.
    // Queries: rooms where memberIds array-contains auth.uid; member/vote lists
    // under an already joined room. No public catalogue or user-profile collection.

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function roomPath(id) { return /databases/$(database)/documents/rooms/$(id); }
    function memberPath(id, uid) { return /databases/$(database)/documents/rooms/$(id)/members/$(uid); }
    function isHost(id) { return signedIn() && request.auth.uid == get(roomPath(id)).data.ownerId; }
    function active(id) { return !get(roomPath(id)).data.get('deleting', false); }
    function isMember(id) { return signedIn() && request.auth.uid in get(roomPath(id)).data.memberIds
      && (active(id) || isHost(id)); }
    function resets(id) { return getAfter(roomPath(id)).data.revision == get(roomPath(id)).data.revision + 1
      && getAfter(roomPath(id)).data.status == 'gathering' && getAfter(roomPath(id)).data.proposal == null; }
    function migration(target) {
      let path = /databases/$(database)/documents/accountMigrations/$(request.auth.uid + '_' + target);
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && exists(path) && get(path).data.targetId == target
        && get(path).data.guestId == request.auth.uid && get(path).data.expiresAt > request.time;
    }
    function validUid(uid) { return uid is string && uid.size() >= 1 && uid.size() <= 128; }
    function validUidAt(ids, index) { return ids.size() <= index || validUid(ids[index]); }
    function validCandidate(id) {
      return id in ['college-games','ago','riverdale','harbourfront','reference-library','kensington','bentway','gardiner','bellwoods','distillery','music','sample-studio']
        || (id is string && id.matches('^option-(0[1-9]|1[0-2])$'));
    }
    function candidatePresent(roomId, candidate) {
      return !candidate.matches('^option-.*') || exists(/databases/$(database)/documents/rooms/$(roomId)/options/$(candidate));
    }
    function proposalPresent(roomId, p) {
      return candidatePresent(roomId, p.candidateId) && (!('stops' in p) ||
        (candidatePresent(roomId, p.stops[1].candidateId) &&
          (p.stops.size() < 3 || candidatePresent(roomId, p.stops[2].candidateId))));
    }
    function validCard(c) {
      return c == null || (c is map && c.keys().hasAll(['areaId','maxSpend','maxTravel','mode','interests','earliest','latest','quiet','indoors','stepFree'])
        && c.keys().hasOnly(['areaId','maxSpend','maxTravel','mode','interests','earliest','latest','quiet','indoors','stepFree'])
        && c.areaId in ['annex','leslieville','liberty','downtown','midtown','junction']
        && c.maxSpend is int && c.maxSpend >= 0 && c.maxSpend <= 200
        && c.maxTravel is int && c.maxTravel >= 5 && c.maxTravel <= 120
        && c.mode in ['transit','walk','bike']
        && c.interests is list && c.interests.size() >= 1 && c.interests.size() <= 6
        && c.interests.hasOnly(['games','art','food','coffee','outdoors','music'])
        && c.interests.toSet().size() == c.interests.size()
        && c.earliest is int && c.earliest >= 360 && c.earliest <= 1380
        && c.latest is int && c.latest >= 390 && c.latest <= 1440 && c.latest - c.earliest >= 90
        && c.quiet is bool && c.indoors is bool && c.stepFree is bool);
    }
    function validStop(s) {
      return s is map && s.keys().hasAll(['candidateId','startMinute','duration','transferMinutes'])
        && s.keys().hasOnly(['candidateId','startMinute','duration','transferMinutes'])
        && validCandidate(s.candidateId) && s.startMinute is int && s.startMinute >= 360
        && s.duration is int && s.duration >= 30 && s.duration <= 240 && s.startMinute + s.duration <= 1440
        && s.transferMinutes is int && s.transferMinutes >= 0 && s.transferMinutes <= 120;
    }
    function validStops(p) {
      return !('stops' in p) || (p.stops is list && p.stops.size() >= 2 && p.stops.size() <= 3
        && validStop(p.stops[0]) && validStop(p.stops[1])
        && p.stops[0].candidateId == p.candidateId && p.stops[0].startMinute == p.startMinute
        && p.stops[0].transferMinutes == 0 && p.stops[0].candidateId != p.stops[1].candidateId
        && p.stops[1].startMinute >= p.stops[0].startMinute + p.stops[0].duration + p.stops[1].transferMinutes
        && (p.stops.size() < 3 || (validStop(p.stops[2])
          && p.stops[2].candidateId != p.stops[0].candidateId && p.stops[2].candidateId != p.stops[1].candidateId
          && p.stops[2].startMinute >= p.stops[1].startMinute + p.stops[1].duration + p.stops[2].transferMinutes)));
    }
    function validProposal(p) {
      return p == null || (p is map && p.keys().hasAll(['candidateId','startMinute','revision'])
        && p.keys().hasOnly(['candidateId','startMinute','revision','stops']) && validStops(p) && validCandidate(p.candidateId)
        && p.startMinute is int && p.startMinute >= 360 && p.startMinute <= 1350
        && p.revision is int && p.revision >= 1 && p.revision <= 1000000);
    }
    function validRoom(d) {
      return d.keys().hasAll(['title','date','city','ownerId','memberIds','status','revision','proposal','lastJoinInviteId','createdAt'])
        && d.keys().hasOnly(['title','date','city','ownerId','memberIds','status','revision','proposal','lastJoinInviteId','createdAt','deleting','migrationTarget','travelSource'])
        && d.get('travelSource', 'estimate') in ['estimate','routed']
        && d.get('deleting', false) is bool && (!('migrationTarget' in d) || validUid(d.migrationTarget))
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 70
        && d.date is string && d.date.size() == 10 && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.city == 'Toronto' && validUid(d.ownerId)
        && d.memberIds is list && d.memberIds.size() >= 1 && d.memberIds.size() <= 8
        && d.memberIds.toSet().size() == d.memberIds.size() && d.ownerId in d.memberIds
        && ((request.method == 'update' && d.memberIds == resource.data.memberIds)
          || (validUidAt(d.memberIds,0) && validUidAt(d.memberIds,1) && validUidAt(d.memberIds,2) && validUidAt(d.memberIds,3)
            && validUidAt(d.memberIds,4) && validUidAt(d.memberIds,5) && validUidAt(d.memberIds,6) && validUidAt(d.memberIds,7)))
        && d.status in ['gathering','voting','confirmed'] && d.revision is int && d.revision >= 0 && d.revision <= 1000000
        && validProposal(d.proposal)
        && (d.status == 'gathering' ? d.proposal == null : d.proposal != null)
        && (d.proposal == null || d.proposal.revision == d.revision)
        && d.lastJoinInviteId is string && d.lastJoinInviteId.matches('^[a-f0-9]{48}$')
        && d.createdAt is timestamp;
    }
    function validMember(d) {
      return d.keys().hasAll(['name','card','inviteId','updatedAt']) && d.keys().hasOnly(['name','card','inviteId','updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 30 && validCard(d.card)
        && d.inviteId is string && d.inviteId.matches('^[a-f0-9]{48}$')
        && d.updatedAt == request.time;
    }
    function validInvite(d) {
      return d.keys().hasAll(['roomId','title','createdBy','expiresAt']) && d.keys().hasOnly(['roomId','title','createdBy','expiresAt'])
        && d.roomId is string && d.roomId.matches('^[a-f0-9]{36}$')
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 70
        && validUid(d.createdBy) && d.expiresAt is timestamp && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(7,'d');
    }
    function inviteAllows(id, token) {
      let invite = get(/databases/$(database)/documents/invites/$(token));
      return invite.data.roomId == id && invite.data.expiresAt > request.time
        && get(roomPath(id)).data.lastJoinInviteId == token && active(id);
    }
    function routeValueAt(minutes, ids, index) {
      return ids.size() <= index || minutes[ids[index]] == null ||
        (minutes[ids[index]] is int && minutes[ids[index]] >= 0 && minutes[ids[index]] <= 300);
    }
    function validRoute(d, id) {
      let ids = get(roomPath(id)).data.memberIds;
      return d.keys().hasAll(['basis','fromId','candidateId','arrivalMinute','minutes','provider','checkedAt','expiresAt','updatedAt'])
        && d.keys().hasOnly(['basis','fromId','candidateId','arrivalMinute','minutes','provider','checkedAt','expiresAt','updatedAt'])
        && d.basis is string && d.basis.matches('^[a-f0-9]{64}$') && validCandidate(d.candidateId)
        && (d.fromId == '' || (validCandidate(d.fromId) && d.fromId != d.candidateId))
        && d.arrivalMinute is int && d.arrivalMinute >= 360 && d.arrivalMinute <= 1440
        && d.provider == 'Transitous' && d.checkedAt is int && d.expiresAt is int
        && d.checkedAt <= request.time.toMillis() + 300000 && d.checkedAt >= request.time.toMillis() - 900000
        && d.expiresAt > request.time.toMillis() && d.expiresAt <= request.time.toMillis() + 1200000
        && d.minutes is map && d.minutes.keys().hasAll(ids) && d.minutes.keys().hasOnly(ids)
        && routeValueAt(d.minutes,ids,0) && routeValueAt(d.minutes,ids,1) && routeValueAt(d.minutes,ids,2) && routeValueAt(d.minutes,ids,3)
        && routeValueAt(d.minutes,ids,4) && routeValueAt(d.minutes,ids,5) && routeValueAt(d.minutes,ids,6) && routeValueAt(d.minutes,ids,7)
        && d.updatedAt == request.time;
    }
    function validVote(d) {
      return d.keys().hasAll(['choice','candidateId','revision','updatedAt']) && d.keys().hasOnly(['choice','candidateId','revision','updatedAt'])
        && d.choice in ['yes','maybe','no'] && validCandidate(d.candidateId)
        && d.revision is int && d.revision >= 1 && d.revision <= 1000000 && d.updatedAt == request.time;
    }
    function validOption(d) {
      return d.keys().hasAll(['name','venue','areaId','cost','tags','noise','indoor','stepFree','description','url','opens','closes','createdBy','updatedAt'])
        && d.keys().hasOnly(['name','venue','areaId','cost','tags','noise','indoor','stepFree','description','url','opens','closes','createdBy','updatedAt','duration','lat','lng','provider','sourceUrl','retrievedAt','sourceFacts'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 70
        && d.venue is string && d.venue.size() >= 1 && d.venue.size() <= 100
        && d.description is string && d.description.size() >= 1 && d.description.size() <= 300
        && d.url is string && d.url.size() <= 1000 && (d.url == '' || d.url.matches('^https://.*'))
        && d.areaId in ['annex','leslieville','liberty','downtown','midtown','junction']
        && d.cost is int && d.cost >= 0 && d.cost <= 200
        && d.tags is list && d.tags.size() >= 1 && d.tags.size() <= 6 && d.tags.toSet().size() == d.tags.size()
        && d.tags.hasOnly(['games','art','food','coffee','outdoors','music'])
        && d.noise is int && d.noise in [1,2,3] && d.indoor is bool && (d.stepFree == null || d.stepFree == true)
        && d.opens is int && d.closes is int && d.opens >= 360 && d.closes <= 1440 && d.closes - d.opens >= d.get('duration', 90)
        && d.get('duration', 90) is int && d.get('duration', 90) >= 30 && d.get('duration', 90) <= 240
        && ((!('lat' in d) && !('lng' in d)) || (d.lat is number && d.lng is number
          && d.lat >= 43.4 && d.lat <= 44 && d.lng >= -80 && d.lng <= -78.8))
        && (!('provider' in d) || (d.provider == 'OpenStreetMap' && d.sourceUrl is string
          && d.sourceUrl.size() <= 200 && d.sourceUrl.matches('^https://www[.]openstreetmap[.]org/(node|way|relation)/[0-9]+$')
          && d.retrievedAt is string && d.retrievedAt.size() <= 40))
        && (!('sourceUrl' in d) || 'provider' in d) && (!('retrievedAt' in d) || 'provider' in d)
        && (!('sourceFacts' in d) || ('provider' in d && validSourceFacts(d.sourceFacts)))
        && validUid(d.createdBy) && d.updatedAt == request.time;
    }
    function validSourceFacts(d) {
      return d is map && d.keys().hasAll(['hours','fee','access']) && d.keys().hasOnly(['hours','fee','access'])
        && d.hours is string && d.hours.size() <= 300 && d.fee is string && d.fee.size() <= 300
        && d.access is string && d.access.size() <= 300;
    }
    function matchingYes(id, uid, proposal) {
      let v = get(/databases/$(database)/documents/rooms/$(id)/votes/$(uid)).data;
      return v.choice == 'yes' && v.revision == proposal.revision && v.candidateId == proposal.candidateId;
    }
    function yesAt(id, d, index) {
      return d.memberIds.size() <= index || matchingYes(id,d.memberIds[index],d.proposal);
    }
    function unanimous(id, d) {
      return d.memberIds.size() >= 2 && yesAt(id,d,0) && yesAt(id,d,1) && yesAt(id,d,2) && yesAt(id,d,3)
        && yesAt(id,d,4) && yesAt(id,d,5) && yesAt(id,d,6) && yesAt(id,d,7);
    }
    match /rooms/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && id.matches('^[a-f0-9]{36}$') && validRoom(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time && request.resource.data.revision == 0
        && request.resource.data.status == 'gathering' && !request.resource.data.get('deleting', false)
        && getAfter(memberPath(id,request.auth.uid)).data.inviteId == request.resource.data.lastJoinInviteId
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinInviteId)).data.roomId == id;
      allow update: if signedIn() && validRoom(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['city','createdAt'])
        && ((active(id) && (joining() || resetting() || proposing() || confirming() || renewing() || editing() || transferring() || departing() || migrating() || settingRoutes())) || markingDelete());
      allow delete: if isHost(id) && resource.data.get('deleting', false);
      function settingRoutes() {
        let d = request.resource.data;
        return request.auth.uid == resource.data.ownerId
          && d.diff(resource.data).affectedKeys().hasOnly(['travelSource','revision','proposal','status'])
          && d.revision == resource.data.revision + 1 && d.status == 'gathering' && d.proposal == null;
      }
      function markingDelete() {
        return request.auth.uid == resource.data.ownerId && request.resource.data.deleting == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting']);
      }
      function migrating() {
        let d = request.resource.data;
        let target = d.get('migrationTarget', '');
        return request.auth.uid in resource.data.memberIds
          && !(request.auth.uid in d.memberIds) && target in d.memberIds && migration(target)
          && d.diff(resource.data).affectedKeys().hasOnly(['memberIds','ownerId','revision','proposal','status','migrationTarget'])
          && d.memberIds.size() >= resource.data.memberIds.size() - 1
          && d.memberIds.size() <= resource.data.memberIds.size()
          && resource.data.memberIds.toSet().difference(d.memberIds.toSet()).hasOnly([request.auth.uid])
          && d.memberIds.toSet().difference(resource.data.memberIds.toSet()).hasOnly([target])
          && !existsAfter(memberPath(id,request.auth.uid)) && existsAfter(memberPath(id,target))
          && (resource.data.ownerId == request.auth.uid ? d.ownerId == target : d.ownerId == resource.data.ownerId)
          && d.revision == resource.data.revision + 1 && d.status == 'gathering' && d.proposal == null;
      }
      function editing() {
        let d = request.resource.data;
        return request.auth.uid == resource.data.ownerId
          && d.diff(resource.data).affectedKeys().hasOnly(['title','date','revision','proposal','status'])
          && d.revision == resource.data.revision + 1 && d.status == 'gathering' && d.proposal == null;
      }
      function transferring() {
        let d = request.resource.data;
        return request.auth.uid == resource.data.ownerId && d.ownerId in resource.data.memberIds
          && d.ownerId != resource.data.ownerId
          && d.diff(resource.data).affectedKeys().hasOnly(['ownerId','revision','proposal','status'])
          && d.revision == resource.data.revision + 1 && d.status == 'gathering' && d.proposal == null;
      }
      function departing() {
        let d = request.resource.data;
        let removed = resource.data.memberIds.toSet().difference(d.memberIds.toSet());
        return request.auth.uid in resource.data.memberIds
          && d.diff(resource.data).affectedKeys().hasOnly(['memberIds','revision','proposal','status'])
          && d.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(d.memberIds) && removed.size() == 1
          && (request.auth.uid == resource.data.ownerId || removed.hasOnly([request.auth.uid]))
          && goneAt(d,0) && goneAt(d,1) && goneAt(d,2) && goneAt(d,3)
          && goneAt(d,4) && goneAt(d,5) && goneAt(d,6) && goneAt(d,7)
          && d.revision == resource.data.revision + 1 && d.status == 'gathering' && d.proposal == null;
      }
      function goneAt(d, index) {
        return resource.data.memberIds.size() <= index || resource.data.memberIds[index] in d.memberIds
          || !existsAfter(memberPath(id, resource.data.memberIds[index]));
      }
      function joining() {
        let d = request.resource.data;
        return !(request.auth.uid in resource.data.memberIds)
          && d.diff(resource.data).affectedKeys().hasOnly(['memberIds','lastJoinInviteId','proposal','status','revision'])
          && d.memberIds.size() == resource.data.memberIds.size() + 1
          && d.memberIds.hasAll(resource.data.memberIds)
          && d.memberIds.toSet().difference(resource.data.memberIds.toSet()).hasOnly([request.auth.uid])
          && !exists(memberPath(id,request.auth.uid))
          && getAfter(memberPath(id,request.auth.uid)).data.inviteId == d.lastJoinInviteId
          && inviteAllows(id,d.lastJoinInviteId)
          && d.revision == resource.data.revision + 1 && d.status == 'gathering' && d.proposal == null;
      }
      function resetting() {
        let d = request.resource.data;
        return request.auth.uid in resource.data.memberIds
          && d.diff(resource.data).affectedKeys().hasOnly(['revision','proposal','status'])
          && d.memberIds == resource.data.memberIds && d.lastJoinInviteId == resource.data.lastJoinInviteId
          && d.revision == resource.data.revision + 1 && d.status == 'gathering' && d.proposal == null
          && getAfter(memberPath(id,request.auth.uid)).data.updatedAt == request.time
          && get(memberPath(id,request.auth.uid)).data.updatedAt != request.time;
      }
      // A confirmed plan reopens only through a card, member or option change.
      function proposing() {
        let d = request.resource.data;
        return request.auth.uid == resource.data.ownerId && resource.data.status != 'confirmed'
          && d.diff(resource.data).affectedKeys().hasOnly(['revision','proposal','status'])
          && d.revision == resource.data.revision + 1 && d.status == 'voting' && d.proposal != null
          && proposalPresent(id, d.proposal);
      }
      function confirming() {
        let d = request.resource.data;
        return request.auth.uid == resource.data.ownerId && resource.data.status == 'voting'
          && d.diff(resource.data).affectedKeys().hasOnly(['status']) && d.status == 'confirmed' && unanimous(id,d);
      }
      // The host replaces an expiring invitation with a new capability for this room.
      function renewing() {
        let d = request.resource.data;
        return request.auth.uid == resource.data.ownerId
          && d.diff(resource.data).affectedKeys().hasOnly(['lastJoinInviteId'])
          && getAfter(/databases/$(database)/documents/invites/$(d.lastJoinInviteId)).data.roomId == id;
      }
      match /routes/{routeId} {
        allow read: if isMember(id);
        allow create, update: if isHost(id) && active(id) && resets(id) && validRoute(request.resource.data, id)
          && routeId == (request.resource.data.fromId == '' ? 'start' : request.resource.data.fromId) + '__' + request.resource.data.candidateId;
        allow delete: if isHost(id) && (!active(id) || resets(id));
      }
      match /events/{eventId} {
        allow read: if isMember(id);
        allow create: if isMember(id) && active(id)
          && request.resource.data.keys().hasAll(['type','actorId','revision','createdAt'])
          && request.resource.data.keys().hasOnly(['type','actorId','revision','createdAt'])
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.type in ['created','joined','card','options','proposal','vote','confirmed','plan']
          && request.resource.data.revision is int && request.resource.data.revision >= 0
          && request.resource.data.revision == get(roomPath(id)).data.revision
          && eventId == request.auth.uid + '-' + request.resource.data.type + '-' + string(request.resource.data.revision)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isHost(id) && !active(id);
      }
      match /members/{uid} {
        allow read: if isMember(id);
        allow create: if !getAfter(roomPath(id)).data.get('deleting', false) && validMember(request.resource.data)
          && ((isOwner(uid) && request.resource.data.card == null
          && uid in getAfter(roomPath(id)).data.memberIds
          && (getAfter(roomPath(id)).data.ownerId == uid || inviteAllows(id,request.resource.data.inviteId)))
          || (signedIn() && migration(uid) && isMember(id) && resets(id)
            && !(request.auth.uid in getAfter(roomPath(id)).data.memberIds)
            && uid in getAfter(roomPath(id)).data.memberIds
            && request.resource.data.name == get(memberPath(id,request.auth.uid)).data.name
            && request.resource.data.card == get(memberPath(id,request.auth.uid)).data.card
            && request.resource.data.inviteId == get(memberPath(id,request.auth.uid)).data.inviteId));
        allow update: if active(id) && isOwner(uid) && isMember(id) && validMember(request.resource.data)
          && request.resource.data.inviteId == resource.data.inviteId
          && getAfter(roomPath(id)).data.revision == get(roomPath(id)).data.revision + 1
          && getAfter(roomPath(id)).data.status == 'gathering' && getAfter(roomPath(id)).data.proposal == null;
        allow delete: if (isHost(id) && !active(id)) || (signedIn()
          && (isOwner(uid) || isHost(id)) && resets(id)
          && !(uid in getAfter(roomPath(id)).data.memberIds));
      }
      match /votes/{uid} {
        allow read: if isMember(id);
        allow create, update: if active(id) && isOwner(uid) && isMember(id) && validVote(request.resource.data)
          && get(roomPath(id)).data.status == 'voting'
          && get(memberPath(id,uid)).data.card != null
          && request.resource.data.revision == get(roomPath(id)).data.proposal.revision
          && request.resource.data.candidateId == get(roomPath(id)).data.proposal.candidateId;
        allow delete: if (isHost(id) && !active(id)) || (signedIn()
          && (isOwner(uid) || isHost(id)) && resets(id)
          && !(uid in getAfter(roomPath(id)).data.memberIds));
      }
      // Twelve fixed slots bound storage and query size. Host edits reopen votes.
      match /options/{optionId} {
        allow read: if isMember(id);
        allow create: if active(id) && signedIn() && optionId.matches('^option-(0[1-9]|1[0-2])$') && validOption(request.resource.data)
          && request.auth.uid == get(roomPath(id)).data.ownerId && request.resource.data.createdBy == request.auth.uid
          && getAfter(roomPath(id)).data.revision == get(roomPath(id)).data.revision + 1
          && getAfter(roomPath(id)).data.status == 'gathering' && getAfter(roomPath(id)).data.proposal == null;
        allow update: if active(id) && signedIn() && validOption(request.resource.data)
          && request.auth.uid == get(roomPath(id)).data.ownerId && request.resource.data.createdBy == resource.data.createdBy
          && getAfter(roomPath(id)).data.revision == get(roomPath(id)).data.revision + 1
          && getAfter(roomPath(id)).data.status == 'gathering' && getAfter(roomPath(id)).data.proposal == null;
        allow delete: if isHost(id) && (!active(id) || resets(id));
      }
    }
    match /invites/{token} {
      allow get: if signedIn() && (isHost(resource.data.roomId) || (resource.data.expiresAt > request.time
        && active(resource.data.roomId) && get(roomPath(resource.data.roomId)).data.lastJoinInviteId == token));
      allow list: if isHost(resource.data.roomId);
      allow create: if signedIn() && token.matches('^[a-f0-9]{48}$') && validInvite(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(roomPath(request.resource.data.roomId)).data.ownerId == request.auth.uid
        && getAfter(roomPath(request.resource.data.roomId)).data.lastJoinInviteId == token
        && getAfter(roomPath(request.resource.data.roomId)).data.title == request.resource.data.title;
      allow update: if false;
      allow delete: if isHost(resource.data.roomId);
    }
    function validName(name) { return name is string && name.size() >= 1 && name.size() <= 30; }
    function validFriendship(d) {
      return d.keys().hasAll(['members','names','inviteId','createdAt']) && d.keys().hasOnly(['members','names','inviteId','createdAt'])
        && d.members is list && d.members.size() == 2 && d.members[0] != d.members[1]
        && validUid(d.members[0]) && validUid(d.members[1]) && d.names is map
        && d.names.keys().hasAll(d.members) && d.names.keys().hasOnly(d.members)
        && validName(d.names[d.members[0]]) && validName(d.names[d.members[1]])
        && d.inviteId is string && d.inviteId.matches('^[a-f0-9]{48}$') && d.createdAt is timestamp;
    }
    function friendInviteAllows(d) {
      let invite = get(/databases/$(database)/documents/friendInvites/$(d.inviteId)).data;
      return invite.ownerId in d.members && invite.ownerId != request.auth.uid && invite.expiresAt > request.time
        && d.names[invite.ownerId] == invite.name;
    }
    match /friendInvites/{token} {
      allow get: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.expiresAt > request.time);
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && token.matches('^[a-f0-9]{48}$') && request.resource.data.keys().hasAll(['ownerId','name','expiresAt'])
        && request.resource.data.keys().hasOnly(['ownerId','name','expiresAt'])
        && request.resource.data.ownerId == request.auth.uid && validName(request.resource.data.name)
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7,'d');
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /friendships/{pair} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && validFriendship(request.resource.data) && request.auth.uid in request.resource.data.members
        && pair == request.resource.data.members[0] + '__' + request.resource.data.members[1]
        && request.resource.data.createdAt == request.time && friendInviteAllows(request.resource.data);
      allow update: if signedIn() && request.auth.uid in resource.data.members && validFriendship(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]);
    }
    function validHistory(d) {
      return d.keys().hasAll(['roomId','revision','title','date','activities','venues','totalCost','calendar','rating','again','createdAt','updatedAt'])
        && d.keys().hasOnly(['roomId','revision','title','date','activities','venues','totalCost','calendar','rating','again','createdAt','updatedAt'])
        && d.roomId is string && d.roomId.size() <= 100 && d.revision is int && d.revision >= 1 && d.revision <= 1000000
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 70
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.activities is list && d.activities.size() >= 1 && d.activities.size() <= 3
        && d.venues is list && d.venues.size() == d.activities.size()
        && historyStrings(d.activities,70) && historyStrings(d.venues,100)
        && d.totalCost is int && d.totalCost >= 0 && d.totalCost <= 600
        && d.calendar is string && d.calendar.size() <= 6000 && d.rating is int && d.rating >= 0 && d.rating <= 5
        && d.again is bool && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function historyStrings(items, max) {
      return items[0] is string && items[0].size() >= 1 && items[0].size() <= max
        && (items.size() < 2 || (items[1] is string && items[1].size() >= 1 && items[1].size() <= max))
        && (items.size() < 3 || (items[2] is string && items[2].size() >= 1 && items[2].size() <= max));
    }
    function validPlanInvitation(d, recipient) {
      let friendship = get(/databases/$(database)/documents/friendships/$(d.friendshipId)).data;
      return d.keys().hasAll(['fromId','fromName','roomId','title','inviteId','friendshipId','expiresAt','createdAt'])
        && d.keys().hasOnly(['fromId','fromName','roomId','title','inviteId','friendshipId','expiresAt','createdAt'])
        && d.fromId == request.auth.uid && recipient != request.auth.uid && validName(d.fromName)
        && d.friendshipId is string && d.friendshipId.size() >= 3 && d.friendshipId.size() <= 258
        && d.roomId is string && d.roomId.matches('^[a-f0-9]{36}$') && isMember(d.roomId)
        && request.auth.uid in friendship.members && recipient in friendship.members
        && d.fromName == get(memberPath(d.roomId,request.auth.uid)).data.name
        && d.title == get(roomPath(d.roomId)).data.title && d.inviteId is string && inviteAllows(d.roomId,d.inviteId)
        && d.expiresAt == get(/databases/$(database)/documents/invites/$(d.inviteId)).data.expiresAt && d.createdAt == request.time;
    }
    function validProfile(d) {
      return d.keys().hasAll(['name','card','updatedAt']) && d.keys().hasOnly(['name','card','updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
        && d.card != null && validCard(d.card) && d.updatedAt == request.time;
    }
    match /accountMigrations/{id} {
      allow read, delete: if signedIn() && (resource.data.guestId == request.auth.uid || resource.data.targetId == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(['guestId','targetId','expiresAt'])
        && request.resource.data.keys().hasOnly(['guestId','targetId','expiresAt'])
        && validUid(request.resource.data.guestId) && request.resource.data.targetId == request.auth.uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.guestId != request.auth.uid
        && id == request.resource.data.guestId + '_' + request.auth.uid
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(10,'m');
    }
    function validDevice(d) {
      return d.keys().hasAll(['fid','platform','updatedAt']) && d.keys().hasOnly(['fid','platform','updatedAt'])
        && d.fid is string && d.fid.size() > 0 && d.fid.size() <= 256
        && d.platform in ['android','ios','web'] && d.updatedAt == request.time;
    }
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      match /history/{plan} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validHistory(request.resource.data) && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid) && validHistory(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','again','updatedAt']);
      }
      match /historyHidden/{plan} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && plan.size() >= 1 && plan.size() <= 120
          && request.resource.data.keys().hasAll(['updatedAt'])
          && request.resource.data.keys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt == request.time;
      }
      match /planInvites/{invitation} {
        allow read, delete: if signedIn() && (request.auth.uid == uid || resource.data.fromId == request.auth.uid);
        allow create, update: if signedIn() && validPlanInvitation(request.resource.data,uid)
          && invitation == request.resource.data.roomId + '_' + request.auth.uid;
      }
      match /devices/{device} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && device.matches('^[a-f0-9]{24}$') && validDevice(request.resource.data);
      }
      match /inbox/{event} {
        allow read, delete: if isOwner(uid);
        allow write: if false;
      }
      match /delivery/{room} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }
    }
    // Collection-group cleanup/export of invitations sent by this identity.
    match /{parent=**}/planInvites/{invitation} {
      allow read, delete: if signedIn() && resource.data.fromId == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
